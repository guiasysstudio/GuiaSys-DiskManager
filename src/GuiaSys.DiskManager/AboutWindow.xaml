<Window x:Class="GuiaSys.DiskManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre o GuiaSys Disk Manager" Width="500" Height="558"
        MinWidth="500" MinHeight="558" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/Branding/GuiaSys-DiskManager.ico">
  <Grid Margin="25,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
      <Image Source="Assets/Branding/logo-128.png" Width="100" Height="100"
             AutomationProperties.Name="Símbolo do GuiaSys Disk Manager"/>
      <TextBlock Text="GuiaSys Disk Manager" FontSize="22" FontWeight="Bold"
                 HorizontalAlignment="Center" Margin="0,10,0,0"/>
      <TextBlock Text="Desenvolvido por GuiaSys Studio"
                 Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="VersionText" AutomationProperties.Name="Versão instalada"/>
        <TextBlock x:Name="ArchitectureText" Margin="0,5,0,0"/>
        <TextBlock Text="Plataforma: Windows 10/11 x64" Margin="0,5,0,0"/>
        <TextBlock Text="Licença: GuiaSys Licensing (GSL-v1)" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14">
      <StackPanel>
        <TextBlock Text="ATUALIZAÇÕES" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Consulta manual de versões públicas oficiais no GitHub."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,9"/>
        <WrapPanel Margin="0,0,0,8">
          <Button x:Name="CheckUpdateButton" Content="Verificar atualização"
                  Click="CheckUpdates_Click" AutomationProperties.Name="Consultar atualização oficial"/>
          <Button x:Name="OpenUpdatePageButton" Content="Abrir versão oficial"
                  Click="OpenUpdatePage_Click" IsEnabled="False"
                  ToolTip="Abre a página verificada no navegador; não executa instaladores"
                  AutomationProperties.Name="Abrir página oficial da nova versão"/>
        </WrapPanel>
        <TextBlock x:Name="UpdateStatusText" Text="Nenhuma consulta realizada."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   AutomationProperties.Name="Resultado da verificação de atualizações"/>
        <TextBlock Text="Nenhum arquivo é baixado ou executado pelo aplicativo. O instalador requer conferência de origem e assinatura antes do uso."
                   TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                   FontSize="11" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <Button Grid.Row="3" Content="Fechar" Width="112" IsCancel="True"
            HorizontalAlignment="Center" Margin="0,12,0,0"/>
  </Grid>
</Window>
