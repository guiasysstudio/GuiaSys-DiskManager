<Window x:Class="GuiaSys.DiskManager.ReinforcedConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Confirmação de operação destrutiva" Width="590" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" Icon="Assets/Branding/GuiaSys-DiskManager.ico"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Atenção: alteração destrutiva" FontSize="22" FontWeight="Bold" Foreground="#FB923C" Margin="0,0,0,14"/><TextBox Grid.Row="1" x:Name="SummaryText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111C2E" Padding="12"/><StackPanel Grid.Row="2" Margin="0,15,0,8"><TextBlock x:Name="InstructionText"/><TextBox x:Name="ConfirmationText" Margin="0,7,0,0" TextChanged="ConfirmationText_Changed"/></StackPanel><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True"/><Button x:Name="ConfirmButton" Content="Confirmar e aplicar" IsEnabled="False" Click="Confirm_Click" Background="#DC6B2F"/></StackPanel></Grid></Window>
