<Window x:Class="GuiaSys.DiskManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:GuiaSys.DiskManager.ViewModels" Title="GuiaSys Disk Manager" Width="1420" Height="860" MinWidth="1080" MinHeight="680" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" Icon="Assets/Branding/GuiaSys-DiskManager.ico" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="6"/></Style>
    <Style x:Key="PartitionBlock" TargetType="Border"><Setter Property="Background" Value="#334155"/><Setter Property="BorderBrush" Value="#64748B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="8"/><Setter Property="Height" Value="76"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="EFI"><Setter Property="Background" Value="#0F766E"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="MSR"><Setter Property="Background" Value="#475569"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="NTFS"><Setter Property="Background" Value="#1D4ED8"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="FAT32"><Setter Property="Background" Value="#0891B2"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="exFAT"><Setter Property="Background" Value="#7C3AED"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Recovery"><Setter Property="Background" Value="#B45309"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="RAW"><Setter Property="Background" Value="#BE123C"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Unallocated"><Setter Property="Background" Value="#263244"/></DataTrigger></Style.Triggers></Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0E1A2B" Padding="20,14" BorderBrush="#20334B" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="Assets/Branding/logo-64.png" Width="54" Height="54" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="GuiaSys Disk Manager" FontSize="25" FontWeight="Bold"/><TextBlock Text="Armazenamento claro, operações controladas" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#16352F" CornerRadius="12" Padding="11,6" Margin="0,0,10,0"><TextBlock Text="{Binding PrivilegeLabel}" Foreground="#5EEAD4"/></Border><Button Content="Atualizar" Command="{Binding RefreshCommand}" Background="{StaticResource AccentBrush}" Foreground="#052E2B" FontWeight="SemiBold"/><Button Content="Logs" Command="{Binding OpenLogsCommand}"/><Button Content="Sobre" Click="About_Click"/></StackPanel></Grid></Border>
    <Border DockPanel.Dock="Bottom" Background="#0E1A2B" BorderBrush="#20334B" BorderThickness="0,1,0,0" Padding="18,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Column="1" Height="5" Margin="14,0" Value="{Binding Progress, Mode=OneWay}" Background="#26384E" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding CapturedAtLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></Border>
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Panel}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Discos" Style="{StaticResource SectionTitle}"/><ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"><ListBox.ContextMenu><ContextMenu><MenuItem Header="Colocar online" Tag="SetDiskOnline" Click="QueuePreset_Click"/><MenuItem Header="Colocar offline" Tag="SetDiskOffline" Click="QueuePreset_Click"/><Separator/><MenuItem Header="Ativar somente leitura" Tag="SetDiskReadOnly" Click="QueuePreset_Click"/><MenuItem Header="Desativar somente leitura" Tag="ClearDiskReadOnly" Click="QueuePreset_Click"/></ContextMenu></ListBox.ContextMenu><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,3" Background="#17253A" CornerRadius="7" Width="276"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"><Run Text="{Binding SizeLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding PartitionStyle, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding BusType, Mode=OneWay}"/></TextBlock><TextBlock Foreground="#5EEAD4" Margin="0,3,0,0"><Run Text="Saúde: "/><Run Text="{Binding HealthStatus, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding OperationalStatus, Mode=OneWay}"/></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Mapa do disco" Style="{StaticResource SectionTitle}"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding PartitionSegments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:PartitionSegmentViewModel}"><Border Style="{StaticResource PartitionBlock}" Width="{Binding Width}" ToolTip="{Binding ToolTip}" MouseLeftButtonDown="PartitionSegment_Click"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource Panel}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Partições e volumes" Style="{StaticResource SectionTitle}"/><DataGrid ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}" AlternationCount="2"><DataGrid.ContextMenu><ContextMenu><MenuItem Header="Formatar…" Tag="FormatPartition" Click="QueuePreset_Click"/><MenuItem Header="Excluir…" Tag="DeletePartition" Click="QueuePreset_Click"/><Separator/><MenuItem Header="Atribuir letra" Tag="SetDriveLetter" Click="QueuePreset_Click"/><MenuItem Header="Remover letra" Tag="RemoveDriveLetter" Click="QueuePreset_Click"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding PartitionNumber}" Width="38"/><DataGridTextColumn Header="Volume" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="95"/><DataGridTextColumn Header="Sistema" Binding="{Binding FileSystem}" Width="80"/><DataGridTextColumn Header="Tamanho" Binding="{Binding SizeLabel}" Width="105"/><DataGridTextColumn Header="Livre" Binding="{Binding FreeLabel}" Width="105"/><DataGridTextColumn Header="Saúde" Binding="{Binding HealthStatus}" Width="85"/></DataGrid.Columns></DataGrid></DockPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Detalhes do disco" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SelectedDisk.FriendlyName}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedDisk.Manufacturer, StringFormat=Fabricante: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedDisk.SerialNumber, StringFormat=Série: {0}}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedDisk.UniqueId, StringFormat=ID: {0}}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedDisk.UniqueId}"/><TextBlock Text="{Binding SelectedDisk.IsReadOnly, StringFormat=Somente leitura: {0}}" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Detalhes da partição" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SelectedPartition.DisplayName}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedPartition.Type, StringFormat=Tipo: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedPartition.Label, StringFormat=Label: {0}}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedPartition.IsHidden, StringFormat=Oculta: {0}}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedPartition.AccessPaths, StringFormat=Caminhos: {0}}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
      </Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Preparar operação" Style="{StaticResource SectionTitle}"/><TextBlock Text="Operação" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding OperationChoices}" DisplayMemberPath="Display" SelectedValuePath="Type" SelectedValue="{Binding SelectedOperationType}" Margin="0,4,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="Sistema" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding SelectedFileSystem}" Margin="0,4,0,8"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Letra" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding DriveLetterInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" MaxLength="1"/></StackPanel></Grid><TextBlock Text="Tamanho (ex.: 20 GB)" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding SizeInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/><TextBlock Text="Unidade de alocação em bytes (opcional)" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding AllocationUnitInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/><TextBlock Text="Label" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding LabelInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,7" MaxLength="32"/><CheckBox Content="Formatação rápida" IsChecked="{Binding QuickFormat}" Margin="2,3,0,8"/><Button Content="Adicionar à fila" Command="{Binding QueueCommand}" Background="{StaticResource AccentBrush}" Foreground="#052E2B" FontWeight="SemiBold"/></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Operações pendentes" Style="{StaticResource SectionTitle}"/><TextBlock Text="Nada é alterado até Aplicar." Foreground="{StaticResource MutedBrush}" Margin="0,-5,0,8"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Desfazer" Command="{Binding UndoCommand}"/><Button Content="Limpar" Command="{Binding ClearCommand}"/><Button Content="Aplicar" Command="{Binding ApplyCommand}" Background="#DC6B2F" FontWeight="SemiBold"/></StackPanel><ListBox ItemsSource="{Binding PendingOperations}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"><ListBox.ItemTemplate><DataTemplate><Border Background="#17253A" CornerRadius="6" Padding="9" Margin="0,3"><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
