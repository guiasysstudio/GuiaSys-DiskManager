<Window x:Class="GuiaSys.DiskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuiaSys Disk Manager — Inventário" Width="1060" Height="710" MinWidth="760" MinHeight="520"
        Background="#101827" Foreground="#E8EDF5">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#172236"/>
            <Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="RowBackground" Value="#172236"/>
            <Setter Property="AlternatingRowBackground" Value="#1E2A40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="GuiaSys Disk Manager" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Inventário seguro — somente leitura (M01)" Foreground="#A8B7CB" FontSize="14" Margin="0,5,0,15"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" Click="Refresh_Click" Padding="18,9" Content="Atualizar discos" Background="#2D8C7D" Foreground="White" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" Margin="18,8,0,0" Text="Aguardando consulta..." Foreground="#A8B7CB"/>
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
            <DataGrid x:Name="DisksGrid" Grid.Row="0" ItemsSource="{Binding Disks}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Disco" Binding="{Binding Number}" Width="60"/>
                    <DataGridTextColumn Header="Modelo" Binding="{Binding FriendlyName}" Width="*"/>
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeLabel}" Width="120"/>
                    <DataGridTextColumn Header="Estilo" Binding="{Binding PartitionStyle}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Sistema" Binding="{Binding IsSystem}" Width="85"/>
                    <DataGridCheckBoxColumn Header="Offline" Binding="{Binding IsOffline}" Width="75"/>
                    <DataGridCheckBoxColumn Header="Somente leitura" Binding="{Binding IsReadOnly}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="Partições detectadas" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,12"/>
            <DataGrid x:Name="PartitionsGrid" Grid.Row="2" ItemsSource="{Binding Partitions}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Disco" Binding="{Binding DiskNumber}" Width="80"/>
                    <DataGridTextColumn Header="Partição" Binding="{Binding PartitionNumber}" Width="100"/>
                    <DataGridTextColumn Header="Letra" Binding="{Binding DriveLetter}" Width="75"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeLabel}" Width="130"/>
                    <DataGridCheckBoxColumn Header="Boot" Binding="{Binding IsBoot}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Sistema" Binding="{Binding IsSystem}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
