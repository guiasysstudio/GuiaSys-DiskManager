<Window x:Class="GuiaSys.DiskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GuiaSys.DiskManager.ViewModels"
        xmlns:models="clr-namespace:GuiaSys.DiskManager.Models"
        Title="GuiaSys Disk Manager" Width="1500" Height="920" FontFamily="Segoe UI" FontSize="13"
        MinWidth="1050" MinHeight="690" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/Branding/GuiaSys-DiskManager.ico" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/></Window.InputBindings>
  <Window.Resources>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FormField" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SizeField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.CreatePartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.ResizePartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResizeField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.ResizePartition}">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MoveField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.MovePartition}">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FormatField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.FormatPartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LabelField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.FormatPartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.SetVolumeLabel}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DriveLetterField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.SetDriveLetter}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuickFormatField" TargetType="CheckBox">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,8,0,10"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.FormatPartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,11"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="FontSize" Value="13"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20364E"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PartitionBlock" TargetType="Border">
      <Setter Property="Height" Value="84"/>
      <Setter Property="Background" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#698198"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="EFI"><Setter Property="Background" Value="#0C766A"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="MSR"><Setter Property="Background" Value="#46566B"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="NTFS"><Setter Property="Background" Value="#1F4E83"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="FAT32"><Setter Property="Background" Value="#0E6478"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="exFAT"><Setter Property="Background" Value="#554284"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Recovery"><Setter Property="Background" Value="#8A531B"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="RAW"><Setter Property="Background" Value="#893047"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Unallocated"><Setter Property="Background" Value="#27354A"/></DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
          <Setter Property="BorderThickness" Value="3"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Branding and global read-only commands. -->
    <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource OutlineBrush}"
            BorderThickness="0,0,0,1" Padding="18,13">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="Assets/Branding/logo-64.png" Width="48" Height="48" Margin="0,0,13,0"
               AutomationProperties.Name="Marca GuiaSys Disk Manager"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="GuiaSys Disk Manager" FontSize="23" FontWeight="Bold"/>
          <TextBlock Text="GERENCIAMENTO DE ARMAZENAMENTO" Foreground="{StaticResource MutedBrush}"
                     FontSize="10" FontWeight="SemiBold" Margin="1,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#183A38" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
            <TextBlock Text="{Binding WriteModeLabel}" Foreground="{StaticResource AccentBrush}"
                       FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <Button Content="↻  Atualizar (F5)" Command="{Binding RefreshCommand}"
                  ToolTip="Reler o inventário do Windows sem alterar discos"
                  Background="#175C58" BorderBrush="#247B74" FontWeight="SemiBold"/>
          <Button Content="Logs" Command="{Binding OpenLogsCommand}"/>
          <Button Content="Licença" Click="License_Click"/>
          <Button Content="Sobre" Click="About_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="194"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="405"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="332" MinWidth="286"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="300"/>
        <RowDefinition Height="5"/>
        <RowDefinition Height="200" MinHeight="125"/>
      </Grid.RowDefinitions>

      <!-- Persistent navigation + inventory: spans workspace and queue. -->
      <Border Grid.Column="0" Grid.RowSpan="3" Background="{StaticResource SidebarBrush}"
              BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,1,0" Padding="14,20,12,14">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="ÁREA DE TRABALHO" Foreground="{StaticResource MutedBrush}"
                       FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
            <Button Style="{StaticResource NavButton}" Content="⌂   Visão geral"
                    Tag="Overview" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="▣   Mapa do disco"
                    Tag="DiskMap" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="≡   Partições e volumes"
                    Tag="Partitions" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="⚙   Preparar operação"
                    Tag="Operations" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="☷   Fila de operações"
                    Tag="Queue" Click="Navigation_Click"/>
            <Separator Background="{StaticResource OutlineBrush}" Margin="0,17,0,15"/>
            <Grid Margin="8,0,3,9">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="DISCOS DETECTADOS" Foreground="{StaticResource MutedBrush}"
                         FontSize="10" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="{Binding Disks.Count}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
            </Grid>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Background="#1B2B3F" CornerRadius="9"
                  Padding="12" Margin="2,12,0,0">
            <StackPanel>
              <TextBlock Text="PROTEÇÃO ATIVA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="Você pode consultar discos e planejar operações. Nenhuma gravação está liberada nesta etapa."
                         Style="{StaticResource Caption}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk, Mode=TwoWay}"
                   Background="Transparent" Foreground="{StaticResource TextBrush}"
                   BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Discos disponíveis">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#1B2C43" BorderBrush="#2E455E" BorderThickness="1"
                        CornerRadius="9" Padding="10,11" ToolTip="{Binding IdentityStrengthLabel}">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource AccentBrush}"
                               Margin="0,6,0,2" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding PartitionStyle}"/><Run Text=" · "/><Run Text="{Binding BusType}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding TechnologyLabel}" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TechnologyLabel}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding HealthStatus, StringFormat=Saúde Windows: {0}}"
                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" ResizeDirection="Columns" ShowsPreview="True"
                    Background="#243A52" ToolTip="Arraste para ajustar a barra lateral"/>

      <!-- Scrollable inventory workspace. -->
      <ScrollViewer x:Name="WorkAreaScroll" Grid.Column="2" Grid.Row="0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Padding="18,18,16,8">
        <StackPanel>
          <StackPanel x:Name="OverviewSection" Margin="0,0,0,16">
            <TextBlock Text="Visão geral do armazenamento" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Inventário do Windows, sem alterações no dispositivo."
                       Style="{StaticResource Caption}" Margin="0,5,0,16"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0">
                <StackPanel>
                  <TextBlock Text="DISCOS" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding Disks.Count}" FontSize="27" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Surface}" Margin="0">
                <StackPanel>
                  <TextBlock Text="CAPACIDADE FÍSICA" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding OverviewMetrics.TotalCapacityLabel}" FontSize="19"
                             FontWeight="SemiBold" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding PartitionCountLabel}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource Surface}" Margin="0">
                <StackPanel>
                  <TextBlock Text="NÃO ALOCADO EM DISCO" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding OverviewMetrics.UnallocatedLabel}" FontSize="19"
                             FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding OverviewMetrics.MonitoredVolumesLabel}"
                             Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
              <TextBlock Text="{Binding OverviewMetrics.IdentityLabel}" Style="{StaticResource Caption}"
                         Margin="0,0,12,0"/>
              <TextBlock Text="{Binding PrivilegeLabel}" Style="{StaticResource Caption}"/>
            </StackPanel>
          </StackPanel>

          <Border x:Name="DiskMapSection" Style="{StaticResource Surface}">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Mapa proporcional do disco" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding SelectedTargetTitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                            Focusable="False" Padding="0,0,0,7">
                <ItemsControl ItemsSource="{Binding PartitionSegments}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PartitionSegmentViewModel}">
                      <Border Style="{StaticResource PartitionBlock}"
                              Width="{Binding Width}" ToolTip="{Binding ToolTip}"
                              MouseLeftButtonDown="PartitionSegment_Click"
                              AutomationProperties.Name="{Binding Title}">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                     Foreground="#E3EBF6" Margin="0,5,0,0"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="Mapa aproximado: partições pequenas têm largura mínima para seleção; consulte os tamanhos exatos abaixo."
                         Style="{StaticResource Caption}" Margin="0,8,0,0"/>
              <TextBlock Text="{Binding SelectedLayoutSummary}" Foreground="{StaticResource AccentBrush}"
                         FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,9"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedUsageSummary}" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedUnallocatedLabel, StringFormat=Não alocado: {0}}"
                           Foreground="{StaticResource AccentBrush}" FontSize="12"/>
              </Grid>
              <ProgressBar Height="9" Minimum="0" Maximum="100"
                           Value="{Binding SelectedAllocatedPercent}" Margin="0,7,0,5"
                           Background="#28435A" Foreground="{StaticResource AccentBrush}"
                           ToolTip="Porcentagem da capacidade particionada, não corresponde à ocupação de arquivos"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedAllocatedLabel, StringFormat=Particionado: {0}}"
                           Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedLargestFreeLabel, StringFormat=Maior faixa livre: {0}}"
                           Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="PartitionsSection" Style="{StaticResource Surface}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Partições e volumes" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Clique na linha para selecionar o alvo da operação." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Limpar seleção" Click="ClearPartition_Click"
                        ToolTip="Voltar às ações do disco inteiro"/>
              </Grid>
              <DataGrid ItemsSource="{Binding Partitions}"
                        SelectedItem="{Binding SelectedPartition, Mode=TwoWay}"
                        Height="260" MinHeight="160" AlternationCount="2"
                        AutomationProperties.Name="Tabela de partições">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding PartitionNumber}" Width="38"/>
                  <DataGridTextColumn Header="Volume" Binding="{Binding DisplayName}" Width="2*"/>
                  <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="*"/>
                  <DataGridTextColumn Header="Sistema" Binding="{Binding FileSystem}" Width="*"/>
                  <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeLabel}" Width="*"/>
                  <DataGridTextColumn Header="Livre no volume" Binding="{Binding FreeLabel}" Width="*"/>
                  <DataGridTextColumn Header="Uso volume" Binding="{Binding UsageLabel}" Width="*"/>
                  <DataGridTextColumn Header="Saúde" Binding="{Binding HealthStatus}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <Border x:Name="DetailsSection" Style="{StaticResource Surface}">
            <StackPanel>
              <TextBlock Text="Detalhes do dispositivo e partição" Style="{StaticResource SectionTitle}"
                         Margin="0,0,0,13"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="DISCO SELECIONADO" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Text="{Binding SelectedDisk.FriendlyName}" FontWeight="SemiBold" Margin="0,6,0,7"
                             TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedDisk.Manufacturer, StringFormat=Fabricante: {0}}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedDisk.TechnologyLabel, StringFormat=Tecnologia: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.ConnectionLabel, StringFormat=Conexão: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.StateLabel, StringFormat=Estado: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.HealthStatus, StringFormat=Saúde Windows: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.LogicalSectorLabel, StringFormat=Setor lógico: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.PhysicalSectorLabel, StringFormat=Setor físico: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.TemperatureLabel, StringFormat=Temperatura: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.IdentityStrengthLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.UniqueId}" Style="{StaticResource Caption}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedDisk.UniqueId}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="PARTIÇÃO SELECIONADA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Text="{Binding SelectedPartition.DisplayName}" FontWeight="SemiBold" Margin="0,6,0,7"
                             TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedPartition.Kind, StringFormat=Classificação: {0}}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedPartition.ProtectionLabel, StringFormat=Proteção: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.Type, StringFormat=Tipo Windows: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.VolumeCapacityLabel, StringFormat=Capacidade do volume: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.UsedLabel, StringFormat=Arquivos utilizados: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.FreeLabel, StringFormat=Livre no volume: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.UsageHealthLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <ProgressBar Minimum="0" Maximum="100" Height="8" Margin="0,6,0,3"
                               Background="#28435A" Foreground="{StaticResource AccentBrush}"
                               Value="{Binding SelectedPartition.UsagePercent}">
                    <ProgressBar.Style>
                      <Style TargetType="ProgressBar">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedPartition.HasVolumeUsage}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ProgressBar.Style>
                  </ProgressBar>
                  <TextBlock Text="{Binding SelectedPartition.Label, StringFormat=Rótulo: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.IsHidden, StringFormat=Oculta: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.AccessPaths}" Style="{StaticResource Caption}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPartition.AccessPaths}" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="3" Grid.Row="0" Width="5" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" ResizeDirection="Columns" ShowsPreview="True"
                    Background="#243A52" ToolTip="Arraste para ajustar o painel de operações"/>

      <!-- Contextual editor: parameter fields appear only for their operation. -->
      <ScrollViewer x:Name="OperationsSection" Grid.Column="4" Grid.Row="0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Padding="13,18,14,8" Background="{StaticResource SidebarBrush}">
        <StackPanel>
          <TextBlock Text="Preparar operação" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="Selecione um alvo para ver as ações disponíveis."
                     Style="{StaticResource Caption}" Margin="0,6,0,14"/>
          <Border Style="{StaticResource Surface}" Background="#183143">
            <StackPanel>
              <TextBlock Text="ALVO ATUAL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="{Binding SelectedTargetTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,4"/>
              <TextBlock Text="{Binding SelectedTargetHint}" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Surface}">
            <StackPanel>
              <TextBlock Text="Ações contextuais" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Ações inseguras ficam desabilitadas; posicione o cursor para ver o motivo."
                         Style="{StaticResource Caption}" Margin="0,6,0,10"/>
              <ItemsControl ItemsSource="{Binding ContextOperations}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button IsEnabled="{Binding IsAvailable}"
                            ToolTip="{Binding Reason}" ToolTipService.ShowOnDisabled="True"
                            Tag="{Binding Type}" Click="ContextAction_Click"
                            Width="125" MinHeight="52" FontSize="11"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="{Binding Display}">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- Conversion feasibility is informational only: no conversion operation is queued. -->
          <Border Style="{StaticResource Surface}" Background="#183143">
            <StackPanel>
              <TextBlock Text="C10 · GPT / MBR" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Análise de conversão de disco (somente leitura). Selecione o disco inteiro, sem partição."
                         Style="{StaticResource Caption}" Margin="0,5,0,9"/>
              <WrapPanel>
                <Button Content="Analisar → GPT"
                        Command="{Binding InspectGptConversionCommand}"
                        ToolTip="Inspeção sem modificar a tabela de partições"/>
                <Button Content="Analisar → MBR"
                        Command="{Binding InspectMbrConversionCommand}"
                        ToolTip="Inspeção de limites MBR por tamanho do setor"/>
              </WrapPanel>
              <TextBlock Text="{Binding ConversionSummary}" TextWrapping="Wrap"
                         FontSize="12" Margin="0,12,0,9"
                         AutomationProperties.Name="Resultado da análise de conversão"/>
              <TextBlock Text="CONVERSÃO COM DADOS NÃO IMPLEMENTADA. O resultado não habilita escrita, não altera partições nem executa MBR2GPT."
                         Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                         FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <Border x:Name="OperationEditor" Style="{StaticResource Surface}">
            <StackPanel>
              <TextBlock Text="Configuração" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="Operação" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <ComboBox x:Name="OperationTypeSelector" ItemsSource="{Binding OperationChoices}"
                          DisplayMemberPath="Display" SelectedValuePath="Type"
                          SelectedValue="{Binding SelectedOperationType, Mode=TwoWay}"
                          AutomationProperties.Name="Tipo de operação"/>
              </StackPanel>
              <StackPanel Style="{StaticResource SizeField}">
                <TextBlock Text="Novo tamanho (ex.: 20 GB ou bytes exatos)"
                           Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SizeInput, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Tamanho de partição"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ResizeField}">
                <Border Background="#1C354A" CornerRadius="8" BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1" Padding="10">
                  <StackPanel>
                    <TextBlock Text="LIMITES CONFIRMADOS PELO WINDOWS"
                               Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResizeBoundsSummary}" Style="{StaticResource Caption}"
                               Margin="0,7,0,10" TextWrapping="Wrap"/>
                    <WrapPanel>
                      <Button Content="Usar mínimo" Command="{Binding UseResizeMinimumCommand}"
                              ToolTip="Preenche o menor tamanho alinhado, sem executar gravação."/>
                      <Button Content="Usar máximo" Command="{Binding UseResizeMaximumCommand}"
                              ToolTip="Preenche o maior tamanho contíguo suportado, sem executar gravação."/>
                    </WrapPanel>
                    <TextBlock Text="Esses valores podem mudar: limites, identidade e layout são novamente verificados antes da execução. Gravações continuam bloqueadas."
                               Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Style="{StaticResource MoveField}">
                <Border Background="#2E2930" BorderBrush="#A27B47" BorderThickness="1"
                        CornerRadius="8" Padding="11">
                  <StackPanel>
                    <TextBlock Text="C09 · MOVIMENTAÇÃO APENAS SIMULADA"
                               Foreground="{StaticResource WarningBrush}" FontSize="12" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <TextBlock Text="Destino: posição absoluta a partir do início do disco, não tamanho da partição. Ex.: 3 GB ou 3145728000 B."
                               Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                    <TextBox Text="{Binding MoveDestinationInput, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Deslocamento de destino em bytes"/>
                    <WrapPanel Margin="0,9,0,8">
                      <Button Content="Sugerir destino" Command="{Binding SuggestMoveDestinationCommand}"
                              ToolTip="Sugere uma faixa inteiramente não alocada, sem copiar dados"/>
                      <Button Content="Analisar geometria" Command="{Binding PreviewMoveCommand}"
                              ToolTip="Calcula somente a prévia; jamais escreve no disco"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding MovePreviewSummary}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" FontSize="12"/>
                    <TextBlock Text="SEM EXECUÇÃO: não existe motor homologado de cópia, verificação de integridade e recuperação. A ação não entra na fila."
                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Style="{StaticResource FormatField}">
                <TextBlock Text="Sistema de arquivos" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding SelectedFileSystem}"
                          AutomationProperties.Name="Sistema de arquivos"/>
              </StackPanel>
              <StackPanel Style="{StaticResource DriveLetterField}">
                <TextBlock Text="Letra (D a Z)" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding DriveLetterInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="1" AutomationProperties.Name="Letra de unidade"/>
              </StackPanel>
              <StackPanel Style="{StaticResource LabelField}">
                <TextBlock Text="Rótulo do volume" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding LabelInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="32" AutomationProperties.Name="Rótulo do volume"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FormatField}">
                <TextBlock Text="Unidade de alocação (bytes, opcional)" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding AllocationUnitInput, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Unidade de alocação"/>
              </StackPanel>
              <CheckBox Style="{StaticResource QuickFormatField}" Content="Formatação rápida"
                        IsChecked="{Binding QuickFormat}"/>
              <Border Background="#2E2930" BorderBrush="#5F4D3A" BorderThickness="1"
                      CornerRadius="8" Padding="10" Margin="0,3,0,10">
                <StackPanel>
                  <TextBlock Text="{Binding SelectedActionStatus}" Foreground="{StaticResource WarningBrush}"
                             FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedActionReason}" Style="{StaticResource Caption}"
                             Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Button Content="＋  Adicionar à fila" Command="{Binding QueueCommand}"
                      Background="#175C58" BorderBrush="#247B74"
                      FontWeight="SemiBold" Padding="12,12"
                      ToolTip="Somente prepara a operação; não escreve no disco"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Resizable operation queue across the working area and editor. -->
      <GridSplitter Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="1"
                    Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Rows" ShowsPreview="True"
                    Background="#243A52" ToolTip="Arraste para ajustar a altura da fila"/>
      <Border x:Name="QueueSection" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="2"
              Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource OutlineBrush}"
              BorderThickness="0,1,0,0" Padding="16,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="286"/></Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="Fila de operações" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding QueuePreviewSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding PendingOperations}" Background="Transparent"
                     Foreground="{StaticResource TextBrush}" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Operações planejadas">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#1B3046" Padding="10,8" Margin="0,2"
                          CornerRadius="7" BorderBrush="#2B445B" BorderThickness="1">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="APLICAÇÃO BLOQUEADA" Foreground="{StaticResource WarningBrush}"
                       FontWeight="SemiBold" FontSize="11"/>
            <TextBlock Text="O planejamento não executa alterações. A gravação depende de homologação."
                       Style="{StaticResource Caption}" Margin="0,6,0,10"/>
            <WrapPanel>
              <Button Content="Desfazer" Command="{Binding UndoCommand}"/>
              <Button Content="Limpar" Command="{Binding ClearCommand}"/>
              <Button Content="Aplicar" Command="{Binding ApplyCommand}"
                      ToolTip="Gravações bloqueadas até a homologação formal"
                      ToolTipService.ShowOnDisabled="True"
                      Background="#A45A28" FontWeight="SemiBold"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#0D1929" BorderBrush="{StaticResource OutlineBrush}"
            BorderThickness="0,1,0,0" Padding="16,9">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <ProgressBar Grid.Column="1" Height="5" Margin="10,0,15,0" Value="{Binding Progress}"
                     Background="#26394D" Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding CapturedAtLabel}" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
