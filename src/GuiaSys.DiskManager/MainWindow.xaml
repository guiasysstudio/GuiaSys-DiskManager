<Window x:Class="GuiaSys.DiskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GuiaSys.DiskManager.ViewModels"
        xmlns:models="clr-namespace:GuiaSys.DiskManager.Models"
        xmlns:controls="clr-namespace:GuiaSys.DiskManager.Controls"
        Title="GuiaSys Disk Manager" Width="1500" Height="920" FontFamily="Segoe UI" FontSize="13"
        MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/Branding/GuiaSys-DiskManager.ico" UseLayoutRounding="True"
        SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/></Window.InputBindings>
  <Window.Resources>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,11"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FormField" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SizeField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.CreatePartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.ResizePartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResizeField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.ResizePartition}">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MoveField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.MovePartition}">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FormatField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.FormatPartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LabelField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.FormatPartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.SetVolumeLabel}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DriveLetterField" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.SetDriveLetter}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuickFormatField" TargetType="CheckBox">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,8,0,10"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedOperationType}" Value="{x:Static models:StorageOperationType.FormatPartition}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="#244866"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="FontSize" Value="13"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D8E9FA"/><Setter Property="Foreground" Value="#0B4F9E"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RibbonButton" TargetType="Button">
      <Setter Property="Background" Value="#0E56A0"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#4D91CF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2378C4"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="White"/><Setter Property="BorderThickness" Value="2"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Foreground" Value="#21588E"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DDECFB"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#176AC2"/><Setter Property="BorderThickness" Value="2"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PartitionBlock" TargetType="Button">
      <Setter Property="Height" Value="67"/>
      <Setter Property="Background" Value="#E3EFFA"/>
      <Setter Property="BorderBrush" Value="#7FAED8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="EFI"><Setter Property="Background" Value="#E2F6F1"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="MSR"><Setter Property="Background" Value="#F2F4F8"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="NTFS"><Setter Property="Background" Value="#F4F9FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="FAT32"><Setter Property="Background" Value="#E7F5FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="exFAT"><Setter Property="Background" Value="#D0BEF0"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Recovery"><Setter Property="Background" Value="#FFF3DD"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="RAW"><Setter Property="Background" Value="#EAB7C3"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Unallocated"><Setter Property="Background" Value="#F3F5F7"/></DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
          <Setter Property="BorderThickness" Value="3"/>
        </DataTrigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
          <Setter Property="BorderThickness" Value="3"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Primary blue ribbon: actions reflect existing VM commands, no fake write capability. -->
    <Border Grid.Row="0" Background="#1268BA" BorderBrush="#0B549B"
            BorderThickness="0,0,0,1" Padding="15,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Background="#FFFFFF" CornerRadius="8" Padding="5" Margin="0,0,12,0">
          <Image Source="Assets/Branding/logo-64.png" Width="42" Height="42"
                 AutomationProperties.Name="Marca GuiaSys Disk Manager"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="GuiaSys Disk Manager" Foreground="#FFFFFF" FontSize="21" FontWeight="Bold"/>
          <TextBlock Text="GERENCIAMENTO DE DISCOS E PARTIÇÕES" Foreground="#D8EBFF"
                     FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#0B4C88" CornerRadius="7" Padding="10,9" Margin="0,0,10,0"
                  ToolTip="Nenhuma alteração física está liberada; licença não remove o bloqueio de segurança.">
            <TextBlock Text="{Binding WriteModeLabel}" Foreground="#FFFFFF"
                       FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <Button Style="{StaticResource RibbonButton}" Content="↻  Atualizar" Command="{Binding RefreshCommand}"
                  ToolTip="Atualizar inventário do Windows (F5); sem gravar em discos"/>
          <Button Style="{StaticResource RibbonButton}" Content="Logs" Command="{Binding OpenLogsCommand}"/>
          <Button Style="{StaticResource RibbonButton}" Content="Licença" Click="License_Click"/>
          <Button Style="{StaticResource RibbonButton}" Content="Sobre" Click="About_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- Quick-access actions comparable to desktop partition managers. -->
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D5E3F2" BorderThickness="0,0,0,1" Padding="12,5">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource ToolbarButton}" Content="Desfazer" Command="{Binding UndoCommand}"
                  ToolTip="Desfazer item da fila em memória"/>
          <Button Style="{StaticResource ToolbarButton}" Content="Limpar" Command="{Binding ClearCommand}"
                  ToolTip="Limpar a fila; nenhuma gravação"/>
          <Button Style="{StaticResource ToolbarButton}" Content="Aplicar" Command="{Binding ApplyCommand}"
                  ToolTip="Bloqueado até a homologação formal da segurança de escrita"
                  ToolTipService.ShowOnDisabled="True"/>
        </StackPanel>
        <!-- Sidebar owns navigation; the second menu was redundant. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="INVENTÁRIO · SOMENTE LEITURA" Foreground="{StaticResource AccentBrush}"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="   F5: atualizar · Ctrl+1…8: navegar" Foreground="{StaticResource MutedBrush}"
                     Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="206" MinWidth="170"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="258" MinWidth="222"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="250"/>
        <RowDefinition Height="5"/>
        <RowDefinition Height="132" MinHeight="92"/>
      </Grid.RowDefinitions>

      <!-- Persistent navigation + inventory: spans workspace and queue. -->
      <Border Grid.Column="0" Grid.RowSpan="3" Background="{StaticResource SidebarBrush}"
              BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,1,0" Padding="9,12,8,9">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="GERENCIAMENTO" Foreground="{StaticResource MutedBrush}"
                       FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
            <Button Style="{StaticResource NavButton}" Content="⌂   Visão geral"
                    Tag="Overview" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="▣   Mapa do disco"
                    Tag="DiskMap" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="≡   Partições e volumes"
                    Tag="Partitions" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="♡   Saúde e diagnósticos"
                    Tag="Health" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="◇   Partições perdidas (prévia)"
                    Tag="Recovery" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="♧   Manutenção (prévia)"
                    Tag="Maintenance" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="⚙   Preparar operação"
                    Tag="Operations" Click="Navigation_Click"/>
            <Button Style="{StaticResource NavButton}" Content="☷   Fila de operações"
                    Tag="Queue" Click="Navigation_Click"/>
            <TextBlock Text="Ctrl+1…8: navegar · F5: atualizar"
                       Style="{StaticResource Caption}" Margin="10,3,0,0"
                       AutomationProperties.Name="Atalhos: Control e números de 1 a 8 para navegar, F5 para atualizar"/>
            <Separator Background="{StaticResource OutlineBrush}" Margin="0,12,0,12"/>
            <Grid Margin="8,0,3,9">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="DISCOS DISPONÍVEIS" Foreground="{StaticResource MutedBrush}"
                         FontSize="10" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="{Binding Disks.Count}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
            </Grid>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Background="#E4F0FC" CornerRadius="9"
                  Padding="12" Margin="2,12,0,0">
            <StackPanel>
              <TextBlock Text="MODO DE CONSULTA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="Inventário e prévias apenas. Gravação física permanece desativada."
                         Style="{StaticResource Caption}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk, Mode=TwoWay}"
                   Background="Transparent" Foreground="{StaticResource TextBrush}"
                   BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Discos disponíveis">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8" Padding="9,9"
                        ToolTip="{Binding IdentityStrengthLabel}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderThickness" Value="1"/>
                      <Setter Property="Background" Value="#FFFFFF"/>
                      <Setter Property="BorderBrush" Value="#D4E0EF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                          <Setter Property="Background" Value="#E4F1FF"/>
                          <Setter Property="BorderBrush" Value="#176AC2"/>
                          <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasAmbiguousUniqueId}" Value="True">
                          <Setter Property="BorderBrush" Value="#B37518"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource AccentBrush}"
                               Margin="0,6,0,2" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding PartitionStyle}"/><Run Text=" · "/><Run Text="{Binding BusType}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding TechnologyLabel}" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TechnologyLabel}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding HealthStatus, StringFormat=Saúde Windows: {0}}"
                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" ResizeDirection="Columns" ShowsPreview="True"
                    Background="#CDDDEE" ToolTip="Arraste para ajustar a barra lateral"/>

      <!-- Scrollable inventory workspace. -->
      <ScrollViewer x:Name="WorkAreaScroll" Grid.Column="2" Grid.Row="0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Padding="14,12,12,8">
        <StackPanel>
          <Border x:Name="PartitionsSection" Focusable="True" AutomationProperties.Name="Tabela de partições" Style="{StaticResource Surface}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Discos e partições" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding SelectedTargetTitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <ToggleButton x:Name="ExpandTableToggle" Margin="3" Padding="10,8"
                                AutomationProperties.Name="Alternar altura da tabela"
                                ToolTip="Mostrar mais linhas mantendo a tabela rolável">
                    <ToggleButton.Style>
                      <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="Mais linhas"/>
                        <Style.Triggers>
                          <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="Menos linhas"/></Trigger>
                        </Style.Triggers>
                      </Style>
                    </ToggleButton.Style>
                  </ToggleButton>
                  <Button Content="Limpar seleção" Click="ClearPartition_Click"
                          ToolTip="Voltar às ações do disco inteiro"/>
                </StackPanel>
              </Grid>
              <DataGrid x:Name="PartitionsGrid" ItemsSource="{Binding Partitions}"
                        SelectedItem="{Binding SelectedPartition, Mode=TwoWay}"
                        IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                        MinHeight="148" AlternationCount="2"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         CanUserResizeColumns="True"
                        AutomationProperties.Name="Tabela de partições">
                <DataGrid.Style>
                  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Setter Property="Height" Value="172"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChecked, ElementName=ExpandTableToggle}" Value="True">
                        <Setter Property="Height" Value="320"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" MinWidth="38" Binding="{Binding PartitionNumber, Mode=OneWay}" Width="38"/>
                  <DataGridTextColumn Header="Volume" MinWidth="145" Binding="{Binding DisplayName, Mode=OneWay}" Width="2*"/>
                  <DataGridTextColumn Header="Tipo" MinWidth="88" Binding="{Binding Kind, Mode=OneWay}" Width="*"/>
                  <DataGridTextColumn Header="Sistema" MinWidth="90" Binding="{Binding FileSystem, Mode=OneWay}" Width="*"/>
                  <DataGridTextColumn Header="Tamanho" MinWidth="94" Binding="{Binding SizeLabel, Mode=OneWay}" Width="*"/>
                  <DataGridTextColumn Header="Livre no volume" MinWidth="115" Binding="{Binding FreeLabel, Mode=OneWay}" Width="*"/>
                  <DataGridTextColumn Header="Uso volume" MinWidth="98" Binding="{Binding UsageLabel, Mode=OneWay}" Width="*"/>
                  <DataGridTextColumn Header="Saúde" MinWidth="95" Binding="{Binding HealthStatus, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <!-- H03-02: MiniTool-like read-only overview of ALL disks.
               Each row owns only Windows-validated half-open extents. -->
          <Border x:Name="DiskMapSection" Focusable="True"
                  AutomationProperties.Name="Mapa de todos os discos e partições"
                  Style="{StaticResource Surface}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <Border DockPanel.Dock="Right" CornerRadius="5" Background="#E4F3FF"
                        Padding="9,4" VerticalAlignment="Center">
                  <TextBlock Text="TODOS OS DISCOS · SOMENTE LEITURA" Foreground="#125A9C"
                             FontWeight="SemiBold" FontSize="10"/>
                </Border>
                <StackPanel>
                  <TextBlock Text="Mapa dos discos" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Clique no disco ou em uma partição para selecionar e analisar. Nada é alterado."
                             Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding DiskMapRows}"
                            AutomationProperties.Name="Discos e suas partições proporcionais">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DiskMapRowViewModel}">
                    <Border Margin="0,0,0,8" CornerRadius="6" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#F9FCFF"/>
                          <Setter Property="BorderBrush" Value="#CADCEE"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter Property="BorderBrush" Value="#176AC2"/>
                              <Setter Property="BorderThickness" Value="2"/>
                              <Setter Property="Background" Value="#EEF6FF"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid Margin="4,4,4,4" MinHeight="90">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="174"/>
                          <ColumnDefinition Width="1"/>
                          <ColumnDefinition Width="*" MinWidth="100"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Tag="{Binding Disk}" Click="DiskRow_Click"
                                Background="Transparent" BorderThickness="0"
                                HorizontalContentAlignment="Left" Padding="8,5"
                                Focusable="True"
                                AutomationProperties.Name="{Binding Disk.DisplayName}"
                                ToolTip="{Binding Disk.IdentityStrengthLabel}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13"
                                       Foreground="#163E67"/>
                            <TextBlock Text="{Binding Summary}" Foreground="#2166AA"
                                       FontSize="11" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding DeviceLabel}" Foreground="#5C718A"
                                       FontSize="10" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DeviceLabel}"/>
                            <TextBlock Text="{Binding SafetyLabel}" Foreground="#8A520C"
                                       FontSize="10" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SafetyLabel}"/>
                          </StackPanel>
                        </Button>
                        <Border Grid.Column="1" Background="#CFDDEC" Margin="0,5"/>
                        <ScrollViewer Grid.Column="2" Margin="6,2,3,2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      Focusable="False"
                                      ToolTip="Arraste a barra inferior para ver todas as partições deste disco.">
                        <ItemsControl ItemsSource="{Binding Segments}"
                                      AutomationProperties.Name="Partições proporcionais do disco">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <controls:ProportionalPartitionPanel
                                ViewportWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                              <Setter Property="controls:ProportionalPartitionPanel.ExtentBytes"
                                      Value="{Binding Size}"/>
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PartitionSegmentViewModel}">
                              <Button Style="{StaticResource PartitionBlock}"
                                      ToolTip="{Binding ToolTip}"
                                      Click="PartitionSegment_Click" Focusable="True"
                                      AutomationProperties.Name="{Binding AccessibleName}"
                                      AutomationProperties.HelpText="{Binding ToolTip}">
                                <Grid ClipToBounds="True" MinWidth="0">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                  </Grid.RowDefinitions>
                                  <!-- Real volume usage only; hidden when Windows supplies no counters. -->
                                  <ProgressBar Grid.Row="0" Height="5" MinWidth="0"
                                               Minimum="0" Maximum="100" IsHitTestVisible="False"
                                               Focusable="False" Margin="0,0,0,5"
                                               Background="#C3DDF2" Foreground="#1579C7"
                                               Value="{Binding UsagePercent, Mode=OneWay}">
                                    <ProgressBar.Style>
                                      <Style TargetType="ProgressBar">
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding HasVolumeUsage}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </ProgressBar.Style>
                                  </ProgressBar>
                                  <TextBlock Grid.Row="1" Text="{Binding MapTypeLabel}"
                                             FontWeight="SemiBold" FontSize="11"
                                             TextTrimming="CharacterEllipsis" Foreground="#153F6B"/>
                                  <TextBlock Grid.Row="2" Text="{Binding MapSizeLabel}"
                                             FontSize="10" Foreground="#315778"
                                             TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="1,4,0,0">
                <Rectangle Fill="#8EC5F7" Width="12" Height="12" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                <TextBlock Text="Dados / NTFS" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <Rectangle Fill="#A8E1D6" Width="12" Height="12" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                <TextBlock Text="EFI / sistema" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <Rectangle Fill="#F3C58D" Width="12" Height="12" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                <TextBlock Text="Recuperação" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <Rectangle Fill="#D9E1EA" Width="12" Height="12" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                <TextBlock Text="Não alocado" Style="{StaticResource Caption}"/>
              </WrapPanel>
              <TextBlock Text="Faixas proporcionais com largura mínima para partições pequenas. Ocupação de arquivos mostrada apenas quando informada pelo Windows."
                         Style="{StaticResource Caption}" Margin="0,7,0,0"/>
              <Expander Header="Detalhes do disco selecionado" IsExpanded="False"
                        Foreground="{StaticResource TextBrush}" Background="Transparent"
                        BorderBrush="{StaticResource OutlineBrush}" Margin="0,7,0,0">
                <StackPanel Margin="4,5,4,3">
                  <TextBlock Text="{Binding SelectedTargetTitle}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SelectedLayoutSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding SelectedUsageSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  <ProgressBar Minimum="0" Maximum="100" Height="7" Margin="0,5,0,0"
                               Value="{Binding SelectedAllocatedPercent, Mode=OneWay}"
                               Background="#E3EEF9" Foreground="{StaticResource AccentBrush}"
                               ToolTip="Capacidade particionada, não ocupação de arquivos"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <StackPanel x:Name="OverviewSection" Focusable="True" Margin="0,0,0,16"
                      AutomationProperties.Name="Visão geral do armazenamento">
            <TextBlock Text="Resumo do armazenamento" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Capacidade reportada pelo Windows · consulta somente leitura"
                       Style="{StaticResource Caption}" Margin="0,4,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0">
                <StackPanel>
                  <TextBlock Text="DISCOS" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding Disks.Count}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Surface}" Margin="0">
                <StackPanel>
                  <TextBlock Text="CAPACIDADE FÍSICA" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding OverviewMetrics.TotalCapacityLabel}" FontSize="19"
                             FontWeight="SemiBold" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding PartitionCountLabel}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource Surface}" Margin="0">
                <StackPanel>
                  <TextBlock Text="NÃO ALOCADO EM DISCO" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding OverviewMetrics.UnallocatedLabel}" FontSize="19"
                             FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding OverviewMetrics.MonitoredVolumesLabel}"
                             Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
              <TextBlock Text="{Binding OverviewMetrics.IdentityLabel}" Style="{StaticResource Caption}"
                         Margin="0,0,12,0"/>
              <TextBlock Text="{Binding PrivilegeLabel}" Style="{StaticResource Caption}"/>
            </StackPanel>
          </StackPanel>

          <Border x:Name="DetailsSection" Style="{StaticResource Surface}">
            <StackPanel>
              <TextBlock Text="Detalhes do dispositivo e partição" Style="{StaticResource SectionTitle}"
                         Margin="0,0,0,13"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="DISCO SELECIONADO" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Text="{Binding SelectedDisk.FriendlyName}" FontWeight="SemiBold" Margin="0,6,0,7"
                             TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedDisk.Manufacturer, StringFormat=Fabricante: {0}}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedDisk.TechnologyLabel, StringFormat=Tecnologia: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.ConnectionLabel, StringFormat=Conexão: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.StateLabel, StringFormat=Estado: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.HealthStatus, StringFormat=Saúde Windows: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.LogicalSectorLabel, StringFormat=Setor lógico: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.PhysicalSectorLabel, StringFormat=Setor físico: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.TemperatureLabel, StringFormat=Temperatura: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.IdentityStrengthLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedDisk.UniqueId}" Style="{StaticResource Caption}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedDisk.UniqueId}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="PARTIÇÃO SELECIONADA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Text="{Binding SelectedPartition.DisplayName}" FontWeight="SemiBold" Margin="0,6,0,7"
                             TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedPartition.Kind, StringFormat=Classificação: {0}}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding SelectedPartition.ProtectionLabel, StringFormat=Proteção: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.Type, StringFormat=Tipo Windows: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.VolumeCapacityLabel, StringFormat=Capacidade do volume: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.UsedLabel, StringFormat=Arquivos utilizados: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.FreeLabel, StringFormat=Livre no volume: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.UsageHealthLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <ProgressBar Minimum="0" Maximum="100" Height="8" Margin="0,6,0,3"
                               Background="#E3EEF9" Foreground="{StaticResource AccentBrush}"
                               Value="{Binding SelectedPartition.UsagePercent, Mode=OneWay}">
                    <ProgressBar.Style>
                      <Style TargetType="ProgressBar">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedPartition.HasVolumeUsage}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ProgressBar.Style>
                  </ProgressBar>
                  <TextBlock Text="{Binding SelectedPartition.Label, StringFormat=Rótulo: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.IsHidden, StringFormat=Oculta: {0}}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedPartition.AccessPaths}" Style="{StaticResource Caption}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPartition.AccessPaths}" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- C13: Windows read-only observations, never SMART pass/fail certification. -->
          <Border x:Name="HealthSection" Focusable="True" AutomationProperties.Name="Saúde e diagnósticos" Style="{StaticResource Surface}">
            <StackPanel>
              <TextBlock Text="C13 · SAÚDE E DIAGNÓSTICOS" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Estados de disco/volume e contadores opcionais de confiabilidade fornecidos pelo Windows."
                         Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <TextBlock Text="{Binding SelectedDisk.DisplayName}" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <Button Content="Analisar indicadores · somente leitura"
                      Command="{Binding InspectHealthCommand}" HorizontalAlignment="Left"
                      ToolTip="Analisa o inventário em memória; use Atualizar (F5) para coletar novas leituras."
                      AutomationProperties.Name="Analisar saúde do disco selecionado"/>
              <TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap" Margin="0,10,0,8"
                         FontWeight="SemiBold" AutomationProperties.Name="Resumo da análise de saúde"/>
              <ItemsControl ItemsSource="{Binding HealthReport.Checks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8">
                      <StackPanel>
                        <TextBlock Text="{Binding Component}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="S.M.A.R.T. COMPLETO NÃO VERIFICADO. Nenhum autoteste, CHKDSK, Repair-Volume ou reparo é executado. Uma condição Windows saudável não garante ausência de falhas."
                         Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="11"
                         FontWeight="SemiBold" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <!-- C14: maintenance risk inspector, no processes, writes, repair or wipe. -->
          <Border x:Name="MaintenanceSection" Focusable="True" AutomationProperties.Name="Manutenção em modo de prévia" Style="{StaticResource Surface}" Background="#F0F5FB">
            <StackPanel>
              <TextBlock Text="C14 · MANUTENÇÃO (SOMENTE PRÉVIA)" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Selecione uma unidade ou partição, depois um tipo de manutenção. A análise usa somente o inventário atual."
                         Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,9"/>
              <TextBlock Text="{Binding SelectedTargetTitle}" Style="{StaticResource Caption}"
                         Margin="0,0,0,8" TextWrapping="Wrap"/>
              <ComboBox ItemsSource="{Binding MaintenanceChoices}" DisplayMemberPath="Display"
                        SelectedValuePath="Task" SelectedValue="{Binding SelectedMaintenanceTask, Mode=TwoWay}"
                        AutomationProperties.Name="Procedimento de manutenção para avaliação"/>
              <Button Content="Avaliar riscos · sem executar" Command="{Binding InspectMaintenanceCommand}"
                      HorizontalAlignment="Left" Margin="0,10,0,7"
                      ToolTip="Não executa CHKDSK, TRIM, limpeza de arquivos, formatação nem apagamento."/>
              <TextBlock Text="{Binding MaintenanceReport.RiskLabel, StringFormat=Classificação: {0}}"
                         Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="0,5,0,8"/>
              <TextBlock Text="{Binding MaintenanceSummary}" TextWrapping="Wrap" FontSize="12"
                         Margin="0,5,0,8" AutomationProperties.Name="Resumo da avaliação de manutenção"/>
              <TextBlock Text="IMPEDIMENTOS / SEGURANÇA" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                         FontSize="11" Margin="0,6,0,4"/>
              <ItemsControl ItemsSource="{Binding MaintenanceReport.Blockers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Style="{StaticResource Caption}"
                               Margin="0,2,0,3"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="EVIDÊNCIAS E LIMITAÇÕES" Foreground="{StaticResource AccentBrush}"
                         FontWeight="SemiBold" FontSize="11" Margin="0,9,0,6"/>
              <ItemsControl ItemsSource="{Binding MaintenanceReport.Checks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="0,7,0,7">
                      <StackPanel>
                        <TextBlock Text="{Binding Component}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="ESTA PRÉVIA NÃO APROVA NENHUMA OPERAÇÃO. Gravação, desfragmentação, TRIM, CHKDSK, exclusão de arquivos e apagamento continuam bloqueados."
                         TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                         FontSize="11" Margin="0,10,0,2"/>
            </StackPanel>
          </Border>
          <!-- C15: inventory-only GPT comparison; it is NOT a disk/sector recovery engine. -->
          <Border x:Name="RecoverySection" Focusable="True" AutomationProperties.Name="Comparação de partições perdidas" Style="{StaticResource Surface}" Background="#F0F5FB">
            <StackPanel>
              <TextBlock Text="C15 · PARTIÇÕES PERDIDAS (ANÁLISE)" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Compare uma referência GPT capturada ANTES da perda com outro inventário do MESMO disco."
                         TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,5,0,10"/>
              <TextBlock Text="{Binding SelectedTargetTitle}" Style="{StaticResource Caption}"
                         TextWrapping="Wrap" Margin="0,0,0,6"/>
              <TextBlock Text="{Binding RecoveryBaseline.Label}" TextWrapping="Wrap"
                         Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,7"/>
              <WrapPanel>
                <Button Content="1 · Capturar referência" Command="{Binding CaptureRecoveryBaselineCommand}"
                        AutomationProperties.Name="Capturar metadados GPT do disco selecionado"
                        ToolTip="Exige disco inteiro GPT, identidade forte e inventário consistente."/>
                <Button Content="2 · Comparar após F5" Command="{Binding CompareRecoveryCommand}"
                        AutomationProperties.Name="Comparar partições com referência anterior"
                        ToolTip="Ativo somente após um novo inventário do mesmo disco."/>
                <Button Content="Descartar referência" Command="{Binding ClearRecoveryBaselineCommand}"
                        AutomationProperties.Name="Descartar metadados GPT salvos em memória"/>
              </WrapPanel>
              <TextBlock Text="{Binding RecoverySummary}" TextWrapping="Wrap" Margin="0,11,0,9"
                         FontWeight="SemiBold" AutomationProperties.Name="Relatório de comparação GPT"/>
              <ItemsControl ItemsSource="{Binding RecoveryReport.Entries}" Margin="0,3,0,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="0,7,0,7">
                      <StackPanel>
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding PositionLabel}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding RecoveryReport.Blockers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat=Impedimento: {0}}" Style="{StaticResource Caption}"
                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,3,0,3"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding RecoveryReport.Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat=Aviso: {0}}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,3,0,3"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="NÃO ESCANEIA DADOS APAGADOS. Área não alocada não comprova recuperação. Não cria partições, não restaura GPT, não copia arquivos e não escreve em disco."
                         TextWrapping="Wrap" FontWeight="SemiBold" FontSize="11"
                         Foreground="{StaticResource WarningBrush}" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="3" Grid.Row="0" Width="5" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" ResizeDirection="Columns" ShowsPreview="True"
                    Background="#CDDDEE" ToolTip="Arraste para ajustar o painel de operações"/>

      <!-- Contextual editor: parameter fields appear only for their operation. -->
      <ScrollViewer x:Name="OperationsSection" Grid.Column="4" Grid.Row="0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Padding="10,12,10,7" Background="{StaticResource SidebarBrush}">
        <StackPanel>
          <TextBlock Text="Ações e assistentes" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="Selecione um disco ou partição; gravações permanecem bloqueadas."
                     Style="{StaticResource Caption}" Margin="0,5,0,12"/>
          <Border Style="{StaticResource Surface}" Background="#EBF4FF">
            <StackPanel>
              <TextBlock Text="ALVO ATUAL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="{Binding SelectedTargetTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,4"/>
              <TextBlock Text="{Binding SelectedTargetHint}" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Surface}">
            <StackPanel>
              <TextBlock Text="Ações contextuais" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="O status e o motivo aparecem em cada ação, mesmo se ela estiver desabilitada."
                         Style="{StaticResource Caption}" Margin="0,6,0,10"/>
              <ItemsControl ItemsSource="{Binding ContextOperations}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#F7FAFE" BorderBrush="{StaticResource OutlineBrush}"
                             BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,7">
                       <StackPanel>
                         <Button IsEnabled="{Binding IsAvailable}"
                                 ToolTip="{Binding Reason}" ToolTipService.ShowOnDisabled="True"
                                 Tag="{Binding Type}" Click="ContextAction_Click"
                                 MinHeight="34" Padding="9,7" HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 AutomationProperties.Name="{Binding Display}">
                           <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                         </Button>
                         <TextBlock Text="{Binding PresentationStatus}" FontSize="10"
                                    FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                    Margin="7,3,7,0" TextWrapping="Wrap"/>
                         <TextBlock Text="{Binding Reason}" FontSize="11"
                                    Foreground="{StaticResource MutedBrush}"
                                    Margin="7,3,7,4" TextWrapping="Wrap"/>
                       </StackPanel>
                     </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- Conversion feasibility is informational only: no conversion operation is queued. -->
          <Border Style="{StaticResource Surface}" Background="#EBF4FF">
            <StackPanel>
              <TextBlock Text="C10 · GPT / MBR" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Análise de conversão de disco (somente leitura). Selecione o disco inteiro, sem partição."
                         Style="{StaticResource Caption}" Margin="0,5,0,9"/>
              <WrapPanel>
                <Button Content="Analisar → GPT"
                        Command="{Binding InspectGptConversionCommand}"
                        ToolTip="Inspeção sem modificar a tabela de partições"/>
                <Button Content="Analisar → MBR"
                        Command="{Binding InspectMbrConversionCommand}"
                        ToolTip="Inspeção de limites MBR por tamanho do setor"/>
              </WrapPanel>
              <TextBlock Text="{Binding ConversionSummary}" TextWrapping="Wrap"
                         FontSize="12" Margin="0,12,0,9"
                         AutomationProperties.Name="Resultado da análise de conversão"/>
              <TextBlock Text="CONVERSÃO COM DADOS NÃO IMPLEMENTADA. O resultado não habilita escrita, não altera partições nem executa MBR2GPT."
                         Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                         FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <!-- C11 previews require two independently selected disks and never queue any copy. -->
          <Border Style="{StaticResource Surface}" Background="#F0F6FC">
            <StackPanel>
              <TextBlock Text="C11 · CLONAGEM (SOMENTE PRÉVIA)" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Origem: disco selecionado à esquerda; selecione uma partição para estudar apenas aquela partição."
                         Style="{StaticResource Caption}" Margin="0,5,0,9" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedTargetTitle}" Style="{StaticResource Caption}"
                         Margin="0,0,0,10" TextWrapping="Wrap"/>
              <TextBlock Text="Disco de destino" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedCloneTargetDisk, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        AutomationProperties.Name="Selecionar disco de destino para prévia de clonagem"/>
              <Button Content="Analisar clonagem · sem gravar" Command="{Binding InspectCloneCommand}"
                      HorizontalAlignment="Left" Margin="0,10,0,6"
                      ToolTip="Somente simulação geométrica; não copia setores e não enfileira operação"/>
              <TextBlock Text="{Binding ClonePreviewSummary}" TextWrapping="Wrap"
                         FontSize="12" Margin="0,9,0,7"
                         AutomationProperties.Name="Resultado da análise de clonagem"/>
              <TextBlock Text="EXECUÇÃO BLOQUEADA: origem e destino não serão modificados. Não existe cópia, VSS, restauração nem verificação de hash implementadas."
                         Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                         FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <!-- C12: analyze installed Windows boot chain, never queue a migration. -->
          <Border Style="{StaticResource Surface}" Background="#F0F5FB">
            <StackPanel>
              <TextBlock Text="C12 · MIGRAR WINDOWS (DIAGNÓSTICO)" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Origem: selecione o disco inteiro que contém o Windows. O Disco 0 pode ser analisado somente para leitura."
                         TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,5,0,8"/>
              <TextBlock Text="{Binding SelectedTargetTitle}" Style="{StaticResource Caption}"
                         TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="Disco de destino para análise de migração" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
              <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedMigrationTargetDisk, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        AutomationProperties.Name="Disco de destino para diagnóstico de migração Windows"/>
              <Button Content="Verificar requisitos do Windows" Command="{Binding InspectMigrationCommand}"
                      HorizontalAlignment="Left" Margin="0,10,0,6"
                      ToolTip="Analisa ESP, MSR, Windows, recuperação, setores e destino RAW sem realizar cópia"/>
              <ItemsControl ItemsSource="{Binding MigrationReport.Checks}" Margin="0,8,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1"
                            Padding="0,6,0,6">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Component}" FontSize="12"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding MigrationSummary}" TextWrapping="Wrap" FontSize="12"
                         Margin="0,9,0,8" AutomationProperties.Name="Relatório de migração Windows"/>
              <TextBlock Text="SOMENTE METADADOS. Boot real, BitLocker, BCD, TPM, VSS, WinRE e restauração não são homologados. NÃO EXECUTA MIGRAÇÃO."
                         TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource WarningBrush}"/>
            </StackPanel>
          </Border>
          <Border x:Name="OperationEditor" Style="{StaticResource Surface}">
            <StackPanel>
              <TextBlock Text="Configuração" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="Operação" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <ComboBox x:Name="OperationTypeSelector" ItemsSource="{Binding OperationChoices}"
                          DisplayMemberPath="Display" SelectedValuePath="Type"
                          SelectedValue="{Binding SelectedOperationType, Mode=TwoWay}"
                          AutomationProperties.Name="Tipo de operação"/>
              </StackPanel>
              <StackPanel Style="{StaticResource SizeField}">
                <TextBlock Text="Novo tamanho (ex.: 20 GB ou bytes exatos)"
                           Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SizeInput, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Tamanho de partição"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ResizeField}">
                <Border Background="#EEF6FF" CornerRadius="8" BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1" Padding="10">
                  <StackPanel>
                    <TextBlock Text="LIMITES CONFIRMADOS PELO WINDOWS"
                               Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResizeBoundsSummary}" Style="{StaticResource Caption}"
                               Margin="0,7,0,10" TextWrapping="Wrap"/>
                    <WrapPanel>
                      <Button Content="Usar mínimo" Command="{Binding UseResizeMinimumCommand}"
                              ToolTip="Preenche o menor tamanho alinhado, sem executar gravação."/>
                      <Button Content="Usar máximo" Command="{Binding UseResizeMaximumCommand}"
                              ToolTip="Preenche o maior tamanho contíguo suportado, sem executar gravação."/>
                    </WrapPanel>
                    <TextBlock Text="Esses valores podem mudar: limites, identidade e layout são novamente verificados antes da execução. Gravações continuam bloqueadas."
                               Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Style="{StaticResource MoveField}">
                <Border Background="#FFF4E5" BorderBrush="#D2A45E" BorderThickness="1"
                        CornerRadius="8" Padding="11">
                  <StackPanel>
                    <TextBlock Text="C09 · MOVIMENTAÇÃO APENAS SIMULADA"
                               Foreground="{StaticResource WarningBrush}" FontSize="12" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <TextBlock Text="Destino: posição absoluta a partir do início do disco, não tamanho da partição. Ex.: 3 GB ou 3145728000 B."
                               Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                    <TextBox Text="{Binding MoveDestinationInput, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Deslocamento de destino em bytes"/>
                    <WrapPanel Margin="0,9,0,8">
                      <Button Content="Sugerir destino" Command="{Binding SuggestMoveDestinationCommand}"
                              ToolTip="Sugere uma faixa inteiramente não alocada, sem copiar dados"/>
                      <Button Content="Analisar geometria" Command="{Binding PreviewMoveCommand}"
                              ToolTip="Calcula somente a prévia; jamais escreve no disco"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding MovePreviewSummary}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" FontSize="12"/>
                    <TextBlock Text="SEM EXECUÇÃO: não existe motor homologado de cópia, verificação de integridade e recuperação. A ação não entra na fila."
                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Style="{StaticResource FormatField}">
                <TextBlock Text="Sistema de arquivos" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding SelectedFileSystem}"
                          AutomationProperties.Name="Sistema de arquivos"/>
              </StackPanel>
              <StackPanel Style="{StaticResource DriveLetterField}">
                <TextBlock Text="Letra (D a Z)" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding DriveLetterInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="1" AutomationProperties.Name="Letra de unidade"/>
              </StackPanel>
              <StackPanel Style="{StaticResource LabelField}">
                <TextBlock Text="Rótulo do volume" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding LabelInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="32" AutomationProperties.Name="Rótulo do volume"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FormatField}">
                <TextBlock Text="Unidade de alocação (bytes, opcional)" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding AllocationUnitInput, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Unidade de alocação"/>
              </StackPanel>
              <CheckBox Style="{StaticResource QuickFormatField}" Content="Formatação rápida"
                        IsChecked="{Binding QuickFormat}"/>
              <Border Background="#FFF4E5" BorderBrush="#EBD0A2" BorderThickness="1"
                      CornerRadius="8" Padding="10" Margin="0,3,0,10">
                <StackPanel>
                  <TextBlock Text="{Binding SelectedActionStatus}" Foreground="{StaticResource WarningBrush}"
                             FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedActionReason}" Style="{StaticResource Caption}"
                             Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Button Content="＋  Adicionar à fila" Command="{Binding QueueCommand}"
                      Background="#176AC2" BorderBrush="#105BA9"
                      FontWeight="SemiBold" Padding="12,12"
                      ToolTip="Somente prepara a operação; não escreve no disco"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Resizable operation queue across the working area and editor. -->
      <GridSplitter Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="1"
                    Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Rows" ShowsPreview="True"
                    Background="#CDDDEE" ToolTip="Arraste para ajustar a altura da fila"/>
      <Border x:Name="QueueSection" Focusable="True" AutomationProperties.Name="Fila de operações" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="2"
              Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource OutlineBrush}"
              BorderThickness="0,1,0,0" Padding="16,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="286"/></Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="Operações pendentes" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding QueuePreviewSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding PendingOperations}" Background="Transparent"
                     Foreground="{StaticResource TextBrush}" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Operações planejadas">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#F5F9FE" Padding="10,8" Margin="0,2"
                          CornerRadius="7" BorderBrush="#D5E4F2" BorderThickness="1">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="APLICAÇÃO BLOQUEADA" Foreground="{StaticResource WarningBrush}"
                       FontWeight="SemiBold" FontSize="11"/>
            <TextBlock Text="A fila é apenas um plano em memória. Use Desfazer ou Limpar na barra superior."
                        Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#EFF5FC" BorderBrush="{StaticResource OutlineBrush}"
            BorderThickness="0,1,0,0" Padding="16,9">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" ToolTip="{Binding Status}"/>
        <ProgressBar Grid.Column="1" Height="5" Margin="10,0,15,0" Value="{Binding Progress, Mode=OneWay}"
                     Background="#DFEBF8" Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding CapturedAtLabel}" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
